<mxfile host="drawio" version="24.0.0">
  <diagram id="topology" name="three-layer">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="wan" value="上游 / 光猫&#10;PPPoE 或 DHCP&#10;0.0.0.0/0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="180" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="router" value="边界层 · K2P B1&#10;&#10;· WAN / NAT / DHCP&#10;· HWNAT 核对&#10;· dnsmasq 唯一入口&#10;· ipset 填充&#10;· 限源访问控制&#10;&#10;192.0.2.1/24（占位）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="360" height="240" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="终端&#10;有线 / 2.4G / 5G&#10;网关与 DNS 均指向 192.0.2.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="760" y="140" width="300" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="box" value="解析层 + 出口层 · 机顶盒&#10;&#10;· 上游解析器（pdnsd / 本地 DoH）&#10;· 单实例守卫&#10;· 出口端口仅对边界层开放&#10;· 探活状态机（契约）&#10;&#10;192.0.2.3（占位）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;strokeWidth=2;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="470" width="360" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="egress" value="分流出口&#10;由使用者自行配置&#10;本仓库不提供" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="860" y="470" width="200" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="WAN" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#475569;" edge="1" parent="1" source="wan" target="router">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="LAN / WiFi" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#475569;" edge="1" parent="1" source="router" target="client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="DNS :53 / 上游 :853/:443" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#475569;exitX=0.15;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="router" target="box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="TCP 转发 → 出口端口" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#475569;exitX=0.75;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="router" target="box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="按规则分流" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1" source="box" target="egress">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
